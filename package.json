{
  "name": "@henrikdukefoss/openclaw-standardcompute",
  "version": "0.1.0",
  "description": "OpenClaw provider plugin for Standard Compute, an OpenAI-compatible LLM gateway with a fixed monthly budget",
  "type": "module",
  "license": "MIT",
  "author": "Standard Compute",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/henrikdukefoss/openclaw-standardcompute.git"
  },
  "homepage": "https://github.com/henrikdukefoss/openclaw-standardcompute#readme",
  "bugs": "https://github.com/henrikdukefoss/openclaw-standardcompute/issues",
  "keywords": [
    "openclaw",
    "openclaw-plugin",
    "standardcompute",
    "llm",
    "provider",
    "gateway"
  ],
  "main": "./dist/index.js",
  "files": [
    "dist",
    "assets",
    "openclaw.plugin.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p .",
    "test": "npm run build && node --test test/*.test.mjs",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "openclaw": ">=2026.10.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "openclaw": "2026.10.3",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=24.16.0 <25 || >=26.1.0"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "providers": [
      "standardcompute"
    ],
    "compat": {
      "pluginApi": ">=2026.10.3",
      "minGatewayVersion": "2026.10.3"
    },
    "build": {
      "openclawVersion": "2026.10.3",
      "pluginSdkVersion": "2026.10.3"
    }
  }
}
